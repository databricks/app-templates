# Local development only. A deployed app gets these from app.yaml and its
# bound resources; see README.
DATABRICKS_CONFIG_PROFILE=your_cli_profile
DATABRICKS_WAREHOUSE_ID=your_sql_warehouse_id
DATABRICKS_VOLUME_FILES=/Volumes/catalog/schema/page_images
DATABRICKS_APP_PORT=8000

# The table holding the AI function output to review: id STRING, response VARIANT.
INPUT_TABLE=catalog.schema.your_ai_function_output
