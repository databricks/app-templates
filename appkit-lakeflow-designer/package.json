{
  "name": "appkit-lakeflow-designer",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "description": "Published Lakeflow Designer app powered by AppKit",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development DISABLE_REMOTE_SERVING=true tsx watch --tsconfig ./tsconfig.server.json --env-file-if-exists=./.env ./server/server.ts",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "tsc -p tests/browser/tsconfig.json && node --experimental-strip-types --test tests/browser/*.test.ts",
    "build": "pnpm run build:server && pnpm run build:client",
    "build:server": "tsc -b tsconfig.server.json && tsdown -c tsdown.server.config.ts",
    "build:client": "tsc -b tsconfig.client.json && vite build --config client/vite.config.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=./.env ./dist/server.js",
    "typecheck": "tsc -b tsconfig.server.json && tsc -b tsconfig.client.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "@databricks/appkit": "0.89.0",
    "@databricks/appkit-ui": "0.89.0",
    "@tanstack/react-table": "8.21.3",
    "@types/express": "4.17.25",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "tw-animate-css": "1.4.0",
    "unist-util-visit": "5.1.0",
    "vega": "6.2.0",
    "vega-embed": "7.0.2",
    "vega-lite": "6.4.3",
    "yaml": "2.8.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/hast": "3.0.5",
    "@types/node": "24.6.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "14.0.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.17",
    "tsdown": "0.20.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "7.3.7"
  }
}
