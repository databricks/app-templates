{
  "name": "designer-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Published Designer app",
  "scripts": {
    "dev": "vite --config client/vite.config.ts",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -b tsconfig.server.json && tsdown -c tsdown.server.config.ts",
    "build:client": "tsc -b tsconfig.client.json && vite build --config client/vite.config.ts",
    "start": "NODE_ENV=production node ./dist/server.js",
    "typecheck": "tsc -b tsconfig.server.json && tsc -b tsconfig.client.json"
  },
  "dependencies": {
    "@databricks/appkit": "0.70.0",
    "@databricks/appkit-ui": "0.70.0",
    "@databricks/sdk-experimental": "0.17.0",
    "@tanstack/react-table": "8.21.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "tw-animate-css": "1.4.0",
    "unist-util-visit": "5.1.0",
    "vega": "6.2.0",
    "vega-embed": "7.0.2",
    "vega-lite": "6.4.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/express": "5.0.5",
    "@types/hast": "3.0.5",
    "@types/node": "24.6.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "tailwindcss": "4.1.17",
    "tsdown": "0.20.3",
    "typescript": "5.9.3",
    "vite": "npm:rolldown-vite@7.1.14"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14",
    "@opentelemetry/core": "2.8.0",
    "systeminformation": "5.31.7"
  }
}
