{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "baseUrl": "../..",
    "paths": {
      "@databricks/chatbot-core": ["./packages/core/src/index.ts"],
      "@databricks/chatbot-utils": ["./packages/utils/src/index.ts"],
      "@databricks/chatbot-auth": ["./packages/auth/src/index.ts"],
