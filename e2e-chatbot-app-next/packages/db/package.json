{
  "name": "@databricks/chatbot-db",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.cjs"
        }
      }
    }
  },
  "files": ["dist", "migrations"],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@ai-sdk/provider": "3.0.6",
    "@databricks/chatbot-auth": "*",
    "@databricks/chatbot-utils": "*",
    "drizzle-orm": "0.45.3",
    "drizzle-kit": "0.31.11",
    "postgres": "3.4.8"
  }
}
