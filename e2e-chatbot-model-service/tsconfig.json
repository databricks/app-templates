{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "isolatedDeclarations": false,
    "baseUrl": ".",
    "paths": {
      "@databricks/chatbot-core": ["./packages/core/src/index.ts"],
      "@databricks/chatbot-utils": ["./packages/utils/src/index.ts"],
      "@databricks/chatbot-auth": ["./packages/auth/src/index.ts"],
      "@databricks/chatbot-ai-sdk-providers": [
        "./packages/ai-sdk-providers/src/index.ts"
      ],
      "@databricks/chatbot-db": ["./packages/db/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
