{
  "datasets": [
    {
      "name": "runs",
      "displayName": "Runs per hour",
      "queryLines": [
        "SELECT date_trunc('HOUR', request_time) AS hour, ",
        "count(*) AS runs, ",
        "count_if(state = 'ERROR') AS failed_runs, ",
        "percentile(CASE WHEN coalesce(tags['mlflow.traceName'], '') <> 'confirm' THEN execution_duration_ms / 1e3 END, 0.95) AS p95_answer_seconds ",
        "FROM agent_traces_trace_unified ",
        "WHERE request_time >= date_sub(current_date(), 7) ",
        "GROUP BY 1 ORDER BY 1 "
      ]
    },
    {
      "name": "app_logs",
      "displayName": "App warnings and errors per hour, by status",
      "queryLines": [
        "SELECT date_trunc('HOUR', time) AS hour, ",
        "coalesce(attributes:status::string, attributes:code::string, severity_text) AS status, ",
        "count(*) AS records ",
        "FROM agent_app_otel_logs ",
        "WHERE severity_text IN ('WARN', 'ERROR') AND instrumentation_scope.name IS NOT NULL AND time >= date_sub(current_date(), 7) ",
        "GROUP BY 1, 2 ORDER BY 1 "
      ]
    },
    {
      "name": "model_calls",
      "displayName": "Model calls per hour",
      "queryLines": [
        "SELECT date_trunc('HOUR', event_time) AS hour, ",
        "count(*) AS calls, ",
        "count_if(status_code = 429) AS rate_limited, ",
        "count_if(status_code = 403) AS refused ",
        "FROM system.ai_gateway.usage ",
        "WHERE endpoint_name IN (concat(current_catalog(), '.', current_schema(), '.sonnet_llm'), concat(current_catalog(), '.', current_schema(), '.opus_llm')) AND event_time >= date_sub(current_date(), 7) ",
        "GROUP BY 1 ORDER BY 1 "
      ]
    }
  ],
