{
  "name": "rag-chat-app",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node --env-file-if-exists=./.env ./dist/server.js",
    "dev": "NODE_ENV=development tsx watch --tsconfig ./tsconfig.server.json --env-file-if-exists=./.env ./server/server.ts",
    "build:client": "tsc -b tsconfig.client.json && vite build --config client/vite.config.ts",
    "build:server": "tsdown -c tsdown.server.config.ts",
    "build": "npm run build:server && npm run build:client",
    "typecheck": "tsc -p ./tsconfig.server.json --noEmit && tsc -p ./tsconfig.client.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ast-grep": "appkit lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "clean": "rm -rf client/dist dist build node_modules",
    "postinstall": "npm run typegen",
    "prebuild": "npm run sync && npm run typegen",
    "predev": "npm run sync && npm run typegen",
    "sync": "appkit plugin sync --write --silent",
    "typegen": "appkit generate-types",
    "setup": "appkit setup --write",
    "sync:bundle-vars": "node scripts/sync-bundle-vars.mjs",
    "deploy": "npm run sync:bundle-vars && databricks bundle deploy && databricks bundle run app"
  },
  "keywords": [],
  "author": "",
  "license": "Unlicensed",
  "description": "Streaming RAG chat app with pgvector retrieval and Lakebase-backed chat history",
  "dependencies": {
    "@ai-sdk/openai": "3.0.52",
    "@ai-sdk/react": "3.0.157",
    "@databricks/appkit": "0.88.0",
    "@databricks/appkit-ui": "0.88.0",
    "@databricks/sdk-experimental": "0.18.0",
    "ai": "6.0.155",
    "clsx": "2.1.1",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "0.546.0",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "3.0.6",
    "react-router": "7.18.4",
    "streamdown": "2.7.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7",
    "tslib": "2.8.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ast-grep/napi": "0.50.0",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "9.39.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "24.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "npm:rolldown-vite@7.1.14"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  }
}
